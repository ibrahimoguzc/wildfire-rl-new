# Chain config: Palisades, 4 seaplanes + 6 eVTOLs, grouped by type, sw3, ws2,
# directional k=3. Chunked version of
# 2M-palisades-4sp6ev-grpbytype-sw3-ws2-directional-k3.slurm, which needs
# ~45 h in one piece and does not fit owl_normal_short.
#
# Sourced by slurms/chain_chunk.slurm. Bash syntax, no side effects.

RUN_NAME=palisades_4sp6ev_grpbytype_sw3_directional_k3
JOB_NAME=pal4sp6ev-chain

# --- chain budget -----------------------------------------------------------
# Exactly one of CHAIN_TOTAL_TIMESTEPS / CHAIN_TOTAL_SIMULATIONS.
CHAIN_TOTAL_TIMESTEPS=2016000
#CHAIN_TOTAL_SIMULATIONS=40000

# --- per-chunk budget -------------------------------------------------------
# Set CHUNK_TIMESTEPS or CHUNK_SIMULATIONS (or neither, to let the chunk fill
# MAX_TRAIN_HOURS). ~44k timesteps/h on this scenario, so 950k ~= 21.5 h.
CHUNK_TIMESTEPS=950000
#CHUNK_SIMULATIONS=20000
MAX_TRAIN_HOURS=22.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=24:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
# Everything except --output-dir/--save-model/--load-model/--resume-summary and
# the budget flags, which chain_chunk.slurm supplies.
SCENARIO="Palisades4sp6ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 4 6
  --controlled-agent-count 10
  --switch-ignition-3
  --water-set 2
  --state-space directional
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

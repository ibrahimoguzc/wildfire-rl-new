# Chain config: CONCURRENT two-mission training. Half the workers fly Palisades
# and half fly Pyrenees at the same time, for the whole run.
#
# This is the third multi-mission arm, and the mechanism is different from the
# other two:
#   679425 / 684399  --missions Palisades -> Pyrenees   (sequential phases)
#   695645           --missions Pyrenees -> Palisades   (sequential phases)
#   THIS RUN         --switch-scenarios A B             (concurrent workers)
#
# --switch-scenarios assigns one scenario per worker in round-robin and the
# worker keeps it across episode resets (ppo_runnerv2 ~line 434, guarded by
# `mission_budgets is None`). With --num-envs 128 and two scenarios that is a
# hard 64/64 split: 64 workers only ever see Palisades, 64 only ever see
# Pyrenees, and every PPO batch mixes both maps instead of alternating between
# them in time. The runner prints the per-scenario worker counts at startup -
# check that line reads 64/64 before trusting a run.
#
# WHY: the sequential runs showed the second mission inherits whatever the
# first left behind - a decayed LR (679425), and no measurable benefit either
# way. Concurrent exposure is the standard remedy for that kind of forgetting,
# and it is the arm the study is missing. It also removes the ordering variable
# entirely, so it is the cleanest test of whether one policy can hold two
# theatres at once.
#
# --scenario is required by slurms/chain_chunk.slurm but the runner explicitly
# ignores it under --switch-scenarios (it prints "ignoring --scenario"), so the
# value below is inert. It is set to Pyrenees for readability only.
#
# Observation width is 69, the same as the --missions runs: the switch-scenario
# path forces include_scenario_features=True, so the policy gets the same 3-way
# scenario one-hot and its checkpoints are comparable to 679425/684399/695645
# (and NOT to the 66-feature single-map runs).
#
# NOTHING here touches the --missions code path. `mission_budgets` stays None,
# which is exactly the condition the round-robin branch keys on, and the two
# branches are mutually exclusive (`if mission_paths: ... elif
# use_switch_scenario: ...`). Runs 679425, 684399 and 695645 are unaffected.

RUN_NAME=concurrent_palisades_pyrenees_5sp5ev_grpbytype_sw4_directional2_k3
JOB_NAME=conc-pal-pyr

# --- chain budget -----------------------------------------------------------
# 150000 total, matching the current comparison set: 717319 (Pyrenees only,
# 150k) and 717320 (Palisades 25k -> Pyrenees 125k).
#
# ON "EQUALLY DIVIDED": round-robin splits WORKERS equally (64/64 at
# --num-envs 128), not episodes. Palisades episodes finish faster in wall time
# than Pyrenees ones (measured 2430 vs 2126 simulations/h per node), so in equal
# wall time the Palisades workers complete more episodes - expect roughly
# 80000 Palisades / 70000 Pyrenees rather than 75000/75000, about 7% off equal.
#
# That is deliberate rather than a limitation worth engineering around: the rate
# ratio is not constant. Pyrenees sped up 17% over the 200k run as its policy
# improved and episodes ended sooner, so any static worker compensation (e.g. a
# padded --switch-scenarios list biased toward Pyrenees) would be tuned to a
# ratio that drifts during training. Equal workers is the stable, reproducible
# definition of "simultaneous and equally divided"; the achieved episode split
# is recorded per scenario in the summary CSV and should be reported as-is.
CHAIN_TOTAL_SIMULATIONS=150000

# --- per-chunk budget -------------------------------------------------------
# Short chunks rather than one long job: fairshare is currently 0.0247 and
# 4 h jobs backfill where a 4-day request sits. ~2200 simulations/h expected
# (a mix of the Palisades 2430/h and Pyrenees 2050/h rates), so MAX_TRAIN_HOURS
# ends each chunk near 7700 simulations and CHUNK_SIMULATIONS never binds.
CHUNK_SIMULATIONS=10000
MAX_TRAIN_HOURS=3.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=04:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Pyrenees5sp5ev.json"   # inert; --switch-scenarios overrides it
TRAIN_ARGS=(
  --switch-scenarios "Palisades5sp5ev.json" "Pyrenees5sp5ev.json"
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 5 5
  --controlled-agent-count 10
  --switch-ignition-4
  --water-set 2
  --state-space directional-2
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

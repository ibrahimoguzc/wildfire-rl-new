# Short pre-maintenance continuation of the 7sp7ev chain.
#
# Same RUN_NAME as chains/pyrenees_7sp7ev_grpbytype_sw4.env on purpose: it
# writes into the same folder, resumes the same model and continues the same
# episode count and LR schedule. Only the wall-clock budget differs, so the
# job fits in the window before the 2026-08-03 08:00 HPCMaintenance
# reservation instead of waiting for it to lift.
#
#   sbatch --job-name pyr7sp7ev-pm --time 03:30:00 --qos owl_normal_short \
#     --cpus-per-task 96 \
#     --export ALL,CHAIN_CONFIG=chains/pyrenees_7sp7ev_grpbytype_sw4_premaint.env,CHAIN_CHUNK=2 \
#     slurms/chain_chunk.slurm

RUN_NAME=pyrenees_7sp7ev_grpbytype_sw4_directional_k3
JOB_NAME=pyr7sp7ev-pm

CHAIN_TOTAL_SIMULATIONS=150000

# 2.25 h of training inside a 2.75 h wall. A 3.5 h wall would have had to start
# within minutes to beat the 07:55 deadline; this leaves ~45 min of scheduling
# slack. At the measured 1557 simulations/h that is roughly 3500 simulations.
# CHUNK_SIMULATIONS stays high so the wall clock is what stops it.
CHUNK_SIMULATIONS=30000
MAX_TRAIN_HOURS=2.25

# Do NOT queue a successor: job 657182 is already queued as the post-maintenance
# continuation and will resume from whatever this job leaves behind. Two
# self-chaining jobs on one output folder would train the same run twice.
AUTO_SUBMIT_NEXT=0

SLURM_TIME=02:45:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

SCENARIO="Pyrenees7sp7ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 7 7
  --controlled-agent-count 14
  --switch-ignition-4
  --water-set 2
  --state-space directional
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

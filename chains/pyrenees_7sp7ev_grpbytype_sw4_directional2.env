# Chain config: Pyrenees, 7 example_seaplane_1 + 7 example_aircraft_1 (eVTOL),
# grouped by aircraft type, switch-ignition-4, water set 2, directional-2 k=3.
#
# Scenario Pyrenees7sp7ev.json was created for this run from Pyrenees7sp5ev.json
# by spreading 7 eVTOLs over the same 4 bases as the seaplanes ([2,2,2,1]).
# Seaplanes are listed before eVTOLs, which is what --group-sizes 7 7 relies on:
# one tactic decision for all 7 seaplanes, one for all 7 eVTOLs.

RUN_NAME=pyrenees_7sp7ev_grpbytype_sw4_directional2_k3
JOB_NAME=pyr7sp7d2-chain

# --- chain budget -----------------------------------------------------------
# The directional (K=3) run of this exact fleet measured 1557-1740 simulations/h,
# so a 30k chunk takes ~18-19 h and 100k is 4 chunks. Same fleet, ignition mode
# and water set as chains/pyrenees_7sp7ev_grpbytype_sw4.env - only the state
# space differs, so the two are a directional vs directional-2 comparison.
# The LR decays over simulations, reaching ~0 at 100000.
CHAIN_TOTAL_SIMULATIONS=100000

# --- per-chunk budget -------------------------------------------------------
# Sized to fit a 24 h job at the pessimistic end of the rate range; the
# wall-clock cutoff takes over if the node is slower than that.
CHUNK_SIMULATIONS=30000
MAX_TRAIN_HOURS=22.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=24:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Pyrenees7sp7ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 7 7
  --controlled-agent-count 14
  --switch-ignition-4
  --water-set 2
  --state-space directional-2
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

# Chain config: Salamis, 6 example_seaplane_1 + 6 example_aircraft_1 (eVTOL),
# grouped by aircraft type, switch-ignition-4, water set 2, directional-2 k=3.
#
# One of three sibling runs (pyrenees 6sp6ev, palisades 6sp6ev) that share
# a fleet, ignition mode, state space and budget, so the maps are comparable
# and we can see which fleet size trains on all three missions.
# Salamis6sp6ev.json was created for this run: seaplanes [6,0] at base 0,
# eVTOLs [0,6] at base 1, matching the Palisades layout.

RUN_NAME=salamis_6sp6ev_grpbytype_sw4_directional2_k3
JOB_NAME=sal6sp6ev-d2

# --- chain budget -----------------------------------------------------------
CHAIN_TOTAL_SIMULATIONS=100000

# --- per-chunk budget -------------------------------------------------------
# Deliberately short chunks. A 4 h job backfills into gaps a 24 h job cannot
# use, so the chain keeps moving instead of sitting behind long queues, and it
# checkpoints often enough to judge early performance and stop cheaply.
# 10000 simulations is ~6 h at the Pyrenees 12-aircraft rate (~1650/h) and ~2 h
# on the faster maps, so on slow maps MAX_TRAIN_HOURS ends the chunk first.
CHUNK_SIMULATIONS=10000
MAX_TRAIN_HOURS=3.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=04:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Salamis6sp6ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 6 6
  --controlled-agent-count 12
  --switch-ignition-4
  --water-set 2
  --state-space directional-2
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

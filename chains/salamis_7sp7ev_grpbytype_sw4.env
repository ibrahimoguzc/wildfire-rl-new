# Chain config: Salamis, 7 example_seaplane_1 + 7 example_aircraft_1 (eVTOL),
# grouped by aircraft type, switch-ignition-4, water set 2, directional k=3.
#
# Companion to chains/pyrenees_7sp7ev_grpbytype_sw4.env and
# chains/salamis_7sp7ev_grpbytype_sw4.env: same fleet, same grouping, same
# ignition mode, so the three maps are directly comparable.
#
# Scenario Salamis7sp7ev.json was created for this run from Palisades4sp6ev
# and follows this map's convention of one base per aircraft type: seaplanes
# [7,0] at base 0, eVTOLs [0,7] at base 1. Seaplanes are listed first, which is
# what --group-sizes 7 7 relies on.

RUN_NAME=salamis_7sp7ev_grpbytype_sw4_directional_k3
JOB_NAME=sal7sp7ev-chain

# --- chain budget -----------------------------------------------------------
CHAIN_TOTAL_SIMULATIONS=100000

# --- per-chunk budget -------------------------------------------------------
# No Salamis run exists to measure, so 20000 is a placeholder matching the
# Palisades chunk. If it does not fit, MAX_TRAIN_HOURS stops the chunk cleanly
# and the chain takes an extra job - nothing is lost. Retune from chunk 1's
# log, which reports the actual simulations/h.
CHUNK_SIMULATIONS=20000
MAX_TRAIN_HOURS=22.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=24:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Salamis7sp7ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 7 7
  --controlled-agent-count 14
  --switch-ignition-4
  --water-set 2
  --state-space directional
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

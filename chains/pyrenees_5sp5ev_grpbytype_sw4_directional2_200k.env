# Chain config: Pyrenees, 5 example_seaplane_1 + 5 example_aircraft_1 (eVTOL),
# grouped by aircraft type, switch-ignition-4, water set 2, directional-2 k=3.
#
# A FRESH 200k run, not a continuation of
# chains/pyrenees_5sp5ev_grpbytype_sw4_directional2.env (which is CHAIN_COMPLETE
# at 150000). That earlier run reached its 150k the awkward way: a 100k schedule
# that decayed to ~1e-09, then a warm restart back to 2.3e-04 when the budget was
# raised. Its last 50k did improve (+2.4 sigma, 85.4% -> 84.4% escapes) but only
# after ~20k of nothing, which is exactly what a mid-run LR discontinuity looks
# like. Starting over gives one continuous 5e-04 -> 0 schedule over the whole
# 200k, so "does this fleet keep improving" is answered without that confound,
# and the curve stays directly comparable to the from-scratch 5sp8ev / 6sp6ev /
# 7sp7ev runs.
#
# Separate RUN_NAME on purpose: same output dir would mean resuming the finished
# 150k policy, which is the opposite of a new chain.
#
# Scenario reused as-is: Pyrenees5sp5ev.json, seaplanes [2,1,1,1] and eVTOLs
# [2,1,1,1] over the map's 4 bases, seaplanes listed first.

RUN_NAME=pyrenees_5sp5ev_grpbytype_sw4_directional2_k3_200k
JOB_NAME=pyr5sp5ev200k

# --- chain budget -----------------------------------------------------------
CHAIN_TOTAL_SIMULATIONS=200000

# --- per-chunk budget -------------------------------------------------------
# Short chunks so the run backfills into gaps a 24 h job cannot use. Measured
# throughput on the finished 150k run was 2060 sims/h, so MAX_TRAIN_HOURS ends
# each chunk at ~7200 simulations and CHUNK_SIMULATIONS never binds; it stays at
# 10000 to match the sibling configs. Expect ~28 chunks, ~97 job-hours,
# ~9300 CPU-hours at 96 CPUs.
CHUNK_SIMULATIONS=10000
MAX_TRAIN_HOURS=3.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=04:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Pyrenees5sp5ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 5 5
  --controlled-agent-count 10
  --switch-ignition-4
  --water-set 2
  --state-space directional-2
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

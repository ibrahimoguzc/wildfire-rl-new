# Chain config: Palisades, 7 example_seaplane_1 + 7 example_aircraft_1 (eVTOL),
# grouped by aircraft type, switch-ignition-4, water set 2, directional k=3.
#
# Companion to chains/pyrenees_7sp7ev_grpbytype_sw4.env and
# chains/salamis_7sp7ev_grpbytype_sw4.env: same fleet, same grouping, same
# ignition mode, so the three maps are directly comparable.
#
# Scenario Palisades7sp7ev.json was created for this run from Palisades4sp6ev
# and follows this map's convention of one base per aircraft type: seaplanes
# [7,0] at base 0, eVTOLs [0,7] at base 1. Seaplanes are listed first, which is
# what --group-sizes 7 7 relies on.

RUN_NAME=palisades_7sp7ev_grpbytype_sw4_directional_k3
JOB_NAME=pal7sp7ev-chain

# --- chain budget -----------------------------------------------------------
CHAIN_TOTAL_SIMULATIONS=100000

# --- per-chunk budget -------------------------------------------------------
# Palisades runs measured 1260-2290 simulations/h depending on fleet, and
# episodes here are longer than Pyrenees ones (23-48 decision steps vs ~16).
# A 7-seaplane fleet sits at the slow end, so 20000 is an estimate, not a
# measurement: if a chunk does not reach it, MAX_TRAIN_HOURS stops it cleanly
# and the chain simply takes an extra job. Retune from chunk 1's log.
CHUNK_SIMULATIONS=20000
MAX_TRAIN_HOURS=22.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=24:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Palisades7sp7ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 7 7
  --controlled-agent-count 14
  --switch-ignition-4
  --water-set 2
  --state-space directional
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

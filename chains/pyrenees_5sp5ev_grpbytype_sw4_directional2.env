# Chain config: Pyrenees, 5 example_seaplane_1 + 5 example_aircraft_1 (eVTOL),
# grouped by aircraft type, switch-ignition-4, water set 2, directional-2 k=3.
#
# One of three sibling runs (palisades 6sp6ev, salamis 6sp6ev) that share
# a fleet, ignition mode, state space and budget, so the maps are comparable
# and we can see which fleet size trains on all three missions.
# Pyrenees5sp5ev.json already existed: seaplanes [2,1,1,1] and eVTOLs
# [2,1,1,1] over the map's 4 bases, seaplanes listed first.

RUN_NAME=pyrenees_5sp5ev_grpbytype_sw4_directional2_k3
JOB_NAME=pyr5sp5ev-d2

# --- chain budget -----------------------------------------------------------
# Extended from 100000 to 150000 on 2026-08-16: the run reached +0.005 reward
# / 85.5% escapes at 100k and was still improving at +4.5 sigma over its last
# 20k, so the budget bound it, not convergence. Raising the total also lifts
# the LR off its floor (1.3e-09 -> 2.3e-04 at simulation 100005), which is a
# warm restart, not a continuation of the original schedule.
CHAIN_TOTAL_SIMULATIONS=150000

# --- per-chunk budget -------------------------------------------------------
# Deliberately short chunks. A 4 h job backfills into gaps a 24 h job cannot
# use, so the chain keeps moving instead of sitting behind long queues, and it
# checkpoints often enough to judge early performance and stop cheaply.
# 10000 simulations is ~6 h at the Pyrenees 12-aircraft rate (~1650/h) and ~2 h
# on the faster maps, so on slow maps MAX_TRAIN_HOURS ends the chunk first.
CHUNK_SIMULATIONS=10000
MAX_TRAIN_HOURS=3.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=04:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Pyrenees5sp5ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 5 5
  --controlled-agent-count 10
  --switch-ignition-4
  --water-set 2
  --state-space directional-2
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

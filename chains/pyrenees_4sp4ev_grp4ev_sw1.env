# Chain config: Pyrenees, 4 seaplanes + 4 eVTOLs, one decision per seaplane and
# one shared by the eVTOLs, sw1, ws2, directional k=3. Chunked version of
# 2M-pyrenees-4sp4ev-grp4ev-sw1-ws2-directional-k3-48h.slurm, which asks for a
# 48 h wall in owl_normal_base.
#
# Budgets are in simulations here (the timesteps variant is in
# palisades_4sp6ev_grpbytype_sw3.env); both are supported.

RUN_NAME=pyrenees_4sp4ev_grp4ev_sw1_directional_k3
JOB_NAME=pyr4sp4ev-chain

# --- chain budget -----------------------------------------------------------
# A simulation total also makes the LR decay over simulations: it starts at
# --learning-rate and reaches ~0 at simulation 45000, continuously across the
# chunks. The count is carried between jobs in chain_progress.json.
CHAIN_TOTAL_SIMULATIONS=45000

# --- per-chunk budget -------------------------------------------------------
# Pyrenees episodes are short (~6 decision steps), so simulations/hour is high;
# take the real rate from chunk 1's log and adjust. MAX_TRAIN_HOURS is the
# backstop if the chunk turns out slower than expected.
CHUNK_SIMULATIONS=15000
MAX_TRAIN_HOURS=22.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=24:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Pyrenees4sp4ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 1 1 1 1 4
  --controlled-agent-count 8
  --switch-ignition-1
  --water-set 2
  --state-space directional
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

# Chain config: Palisades, 5 example_seaplane_1 + 8 example_aircraft_1 (eVTOL),
# grouped by aircraft type, switch-ignition-4, water set 2, directional-2 k=3.
#
# Matched pair with chains/pyrenees_5sp8ev_grpbytype_sw4_directional2.env:
# same 13-aircraft fleet, ignition mode, state space and budget, so the two
# maps differ only by terrain. Note Palisades saturated at 12 aircraft
# (0.4% escapes), so this one may well saturate too - it is here as the
# Palisades half of the pair, not because it is expected to train well.
# Palisades5sp8ev.json was created for this run, following the map's
# convention of one base per type: seaplanes [5,0], eVTOLs [0,8]. Matched
# fleet to chains/pyrenees_5sp8ev_grpbytype_sw4_directional2.env.

RUN_NAME=palisades_5sp8ev_grpbytype_sw4_directional2_k3
JOB_NAME=pal5sp8ev-d2

# --- chain budget -----------------------------------------------------------
CHAIN_TOTAL_SIMULATIONS=100000

# --- per-chunk budget -------------------------------------------------------
# Deliberately short chunks. A 4 h job backfills into gaps a 24 h job cannot
# use, so the chain keeps moving instead of sitting behind long queues, and it
# checkpoints often enough to judge early performance and stop cheaply.
# 10000 simulations is ~6 h at the Pyrenees 12-aircraft rate (~1650/h) and ~2 h
# on the faster maps, so on slow maps MAX_TRAIN_HOURS ends the chunk first.
CHUNK_SIMULATIONS=10000
MAX_TRAIN_HOURS=3.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=04:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Palisades5sp8ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 5 8
  --controlled-agent-count 13
  --switch-ignition-4
  --water-set 2
  --state-space directional-2
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

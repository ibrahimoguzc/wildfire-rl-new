# Chain config: 75000 Palisades then 75000 Pyrenees, 150000 total, sequential
# phases (--missions with equal weights).
#
# CHUNKED TWIN of the single job 730528, which is running the identical
# experiment. 730528 landed on owl-hm002 and is sustaining ~1200 simulations/h
# instead of the ~2400/h every other run got on the owl0xx nodes, so at that
# rate --max-train-hours 92 would stop it around 111000 simulations - Palisades
# done, Pyrenees truncated at ~36000. This chain is the insurance: 3.5 h chunks
# schedule far better at the current fairshare (0.033), are immune to a single
# wall limit, and land wherever the scheduler has room rather than being stuck
# on one slow node for four days.
#
# Both are deliberately left running. Whichever finishes first is the arm; if
# 730528 recovers its rate it wins on wall-clock, and if it truncates this one
# still delivers the full 150000. They write to DIFFERENT output directories
# (this one gets the _chain suffix from RUN_NAME) so nothing collides.
#
# EMAIL: MAIL_USER is deliberately unset so SLURM sends no per-chunk BEGIN/END
# mail - a ~25-chunk chain would otherwise produce ~50 messages. FINAL_MAIL_USER
# makes slurms/chain_chunk.slurm send exactly one message when CHAIN_COMPLETE is
# written. That hook is opt-in and no other config sets it.

RUN_NAME=missions_pal75k_pyr75k_5sp5ev_grpbytype_sw4_directional2_k3
JOB_NAME=pal75-pyr75

CHAIN_TOTAL_SIMULATIONS=150000

# ~7500 simulations per 3.5 h chunk at the owl0xx rate, so expect ~20-25 chunks.
CHUNK_SIMULATIONS=10000
MAX_TRAIN_HOURS=3.5

SLURM_TIME=04:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
# MAIL_USER intentionally unset - see EMAIL note above.
FINAL_MAIL_USER=ibrahimoguz@vt.edu

SCENARIO="Palisades5sp5ev.json"   # inert; --missions overrides it
TRAIN_ARGS=(
  --missions "Palisades5sp5ev.json" "Pyrenees5sp5ev.json"
  --mission-weights 1 1
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 5 5
  --controlled-agent-count 10
  --switch-ignition-4
  --water-set 2
  --state-space directional-2
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

# Chain config: Pyrenees, 5 example_seaplane_1 + 8 example_aircraft_1 (eVTOL),
# grouped by aircraft type, switch-ignition-4, water set 2, directional-2 k=3.
#
# 13 aircraft, sitting between the 12-aircraft 6sp6ev and 14-aircraft 7sp7ev
# runs but with the seaplane count held at 5, matching
# chains/pyrenees_5sp5ev_grpbytype_sw4_directional2.env. Comparing the two
# isolates what 3 extra eVTOLs buy at a fixed seaplane count - which also
# matters for cost, since seaplane count drives simulation time far more than
# eVTOL count does.
# Pyrenees5sp8ev.json was created for this run: seaplanes [2,1,1,1] and eVTOLs
# [2,2,2,2] over the map's 4 bases, seaplanes listed first.

RUN_NAME=pyrenees_5sp8ev_grpbytype_sw4_directional2_k3
JOB_NAME=pyr5sp8ev-d2

# --- chain budget -----------------------------------------------------------
CHAIN_TOTAL_SIMULATIONS=100000

# --- per-chunk budget -------------------------------------------------------
# Deliberately short chunks. A 4 h job backfills into gaps a 24 h job cannot
# use, so the chain keeps moving instead of sitting behind long queues, and it
# checkpoints often enough to judge early performance and stop cheaply.
# 10000 simulations is ~6 h at the Pyrenees 12-aircraft rate (~1650/h) and ~2 h
# on the faster maps, so on slow maps MAX_TRAIN_HOURS ends the chunk first.
CHUNK_SIMULATIONS=10000
MAX_TRAIN_HOURS=3.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=04:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Pyrenees5sp8ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 5 8
  --controlled-agent-count 13
  --switch-ignition-4
  --water-set 2
  --state-space directional-2
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)

# Chain config: Pyrenees, 7 example_seaplane_1 + 7 example_aircraft_1 (eVTOL),
# grouped by aircraft type, switch-ignition-4, water set 2, directional k=3.
#
# Scenario Pyrenees7sp7ev.json was created for this run from Pyrenees7sp5ev.json
# by spreading 7 eVTOLs over the same 4 bases as the seaplanes ([2,2,2,1]).
# Seaplanes are listed before eVTOLs, which is what --group-sizes 7 7 relies on:
# one tactic decision for all 7 seaplanes, one for all 7 eVTOLs.

RUN_NAME=pyrenees_7sp7ev_grpbytype_sw4_directional_k3
JOB_NAME=pyr7sp7ev-chain

# --- chain budget -----------------------------------------------------------
# ~1300-1550 simulations/h measured on this fleet class (see chains/README.md),
# so ~30-35k per 22.5 h chunk: 150k simulations is roughly 5 chunks / 5 days.
# The LR decays over simulations, reaching ~0 at 150000.
CHAIN_TOTAL_SIMULATIONS=150000

# --- per-chunk budget -------------------------------------------------------
# Sized to fit a 24 h job at the pessimistic end of the rate range; the
# wall-clock cutoff takes over if the node is slower than that.
CHUNK_SIMULATIONS=30000
MAX_TRAIN_HOURS=22.5

# --- SLURM ------------------------------------------------------------------
SLURM_TIME=24:00:00
SLURM_QOS=owl_normal_short
SLURM_CPUS=96
MAIL_USER=ibrahimoguz@vt.edu

# --- training args ----------------------------------------------------------
SCENARIO="Pyrenees7sp7ev.json"
TRAIN_ARGS=(
  --num-envs 128
  --device cpu
  --vec-start-method fork
  --state-fire-fronts 3
  --gc-collect-on-reset
  --n-epochs 5
  --learning-rate 0.0005
  --gamma 0.99
  --group-sizes 7 7
  --controlled-agent-count 14
  --switch-ignition-4
  --water-set 2
  --state-space directional
  --cell-size code
  --summary-retention 3
  --checkpoint-interval 252000
)
